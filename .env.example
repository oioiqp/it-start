# IT-Старт — Пример файла переменных окружения (.env)
# Скопируйте этот файл в .env и укажите ваши реальные значения:

# Токен сообщества ВКонтакте (VK Community Access Token)
VK_BOT_TOKEN=""

# ID сообщества ВКонтакте (числовой без минуса или screen_name)
VK_GROUP_ID=""

# ID VK Mini App (если зарегистрировано в VK Developers)
VK_APP_ID=""

# Токен Telegram-бота
TELEGRAM_BOT_TOKEN=""

# Настройки базы данных Supabase (если используются кастомные)
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""
