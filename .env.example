# IT-Старт — Пример файла переменных окружения (.env)
# Скопируйте этот файл в .env для локальной разработки или внесите значения
# в панель управления Koyeb (Service Settings -> Environment Variables).

# --- Сетевые настройки сервиса (Koyeb / Cloud) ---
# Порт приложения (Koyeb по умолчанию использует 8000)
PORT=8000
NODE_ENV="production"

# Публичный URL вашего приложения на Koyeb (например: https://it-start-bot.koyeb.app)
KOYEB_PUBLIC_URL="https://it-start-bot.koyeb.app"
PUBLIC_URL="https://it-start-bot.koyeb.app"

# --- Токены ботов (Telegram & VKontakte) ---
# Токен Telegram-бота от @BotFather (например: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=""

# Токен сообщества ВКонтакте (VK Community Access Token)
VK_BOT_TOKEN=""

# ID сообщества ВКонтакте (числовой без минуса или screen_name)
VK_GROUP_ID="242573933"

# ID VK Mini App (если зарегистрировано в VK Developers)
VK_APP_ID="54857681"

# Ссылка на сообщество VK
VK_COMMUNITY_URL="https://vk.com/club242573933"

# --- База данных Supabase (по умолчанию подключена официальная БД проекта) ---
# SUPABASE_URL="https://pmgsymacvhzsixbpndsn.supabase.co"
# SUPABASE_ANON_KEY="..."
